        "operationId": "obtener_version_documento_legal_v1_documentos_legales__tipo__versiones__version__get",
        "parameters": [
          {
            "name": "tipo",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "terminos",
                "open-data",
                "open-finance"
