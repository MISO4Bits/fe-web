  "components": {
    "schemas": {
      "ConfirmacionRequest": {
        "properties": {
          "oobCode": {
            "type": "string",
            "maxLength": 512,
            "minLength": 10,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Oobcode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "oobCode"
        ],
        "title": "ConfirmacionRequest"
      },
      "ConsentimientoVistaOut": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "OPEN_FINANCE",
              "OPEN_DATA"
            ],
            "title": "Scope"
          },
          "estado": {
            "type": "string",
            "enum": [
              "OTORGADO",
              "REVOCADO",
              "NO_OTORGADO"
            ],
            "title": "Estado"
          },
          "vigente": {
            "type": "boolean",
            "title": "Vigente"
          },
          "actualizadoEn": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actualizadoen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope",
          "estado",
          "vigente"
        ],
        "title": "ConsentimientoVistaOut"
      },
      "CotizacionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "estado": {
            "type": "string",
            "enum": [
              "VIGENTE",
              "EXPIRADA"
            ],
            "title": "Estado"
          },
          "producto": {
            "type": "string",
            "const": "VIDA_HIPOTECARIO",
            "title": "Producto"
          },
          "oferta": {
            "$ref": "#/components/schemas/OfertaOut"
          },
          "perfilRiesgo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PerfilRiesgoOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "vigenciaCotizacion": {
            "$ref": "#/components/schemas/VigenciaOut"
          },
          "creadaEn": {
            "type": "string",
            "format": "date-time",
            "title": "Creadaen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "estado",
          "producto",
          "oferta",
          "vigenciaCotizacion",
          "creadaEn"
        ],
        "title": "CotizacionOut"
      },
      "CotizacionRequest": {
        "properties": {
          "datosCredito": {
            "$ref": "#/components/schemas/DatosCreditoRequest"
          },
          "cuestionarioHabitos": {
            "$ref": "#/components/schemas/CuestionarioHabitosRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "datosCredito",
          "cuestionarioHabitos"
        ],
        "title": "CotizacionRequest"
      },
      "CredencialesRequest": {
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CredencialesRequest"
      },
      "CuentaOut": {
        "properties": {
          "clienteId": {
            "type": "string",
            "title": "Clienteid"
          },
          "primerNombre": {
            "type": "string",
            "title": "Primernombre"
          },
          "segundoNombre": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segundonombre"
          },
          "primerApellido": {
            "type": "string",
            "title": "Primerapellido"
          },
          "segundoApellido": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segundoapellido"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "telefono": {
            "type": "string",
            "title": "Telefono"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "BLOQUEADO",
              "INACTIVO"
            ],
            "title": "Estado"
          },
          "correoConfirmado": {
            "type": "boolean",
            "title": "Correoconfirmado",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "clienteId",
          "primerNombre",
          "primerApellido",
          "email",
          "telefono",
          "estado"
        ],
        "title": "CuentaOut"
      },
      "CuestionarioHabitosRequest": {
        "properties": {
          "consumeTabaco": {
            "type": "boolean",
            "title": "Consumetabaco"
          },
          "actividadFisica": {
            "type": "string",
            "enum": [
              "NUNCA",
              "OCASIONAL",
              "REGULAR"
            ],
            "title": "Actividadfisica"
          },
          "condicionesPreexistentes": {
            "type": "boolean",
            "title": "Condicionespreexistentes"
          },
          "dependientesEconomicos": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Dependienteseconomicos"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "consumeTabaco",
          "actividadFisica",
          "condicionesPreexistentes",
          "dependientesEconomicos"
        ],
        "title": "CuestionarioHabitosRequest"
      },
      "DatosCreditoRequest": {
        "properties": {
          "valorCredito": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 10000000.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
